# Primeiro início: configura a conta inicial. Nunca use estas linhas como uma senha real.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Armazenamento local. No Railway, anexe um volume em /data e defina DATA_DIR=/data.
DATA_DIR=./data
# Cole a chave somente nas variáveis secretas do Railway ou em .env.local ignorado pelo Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# URL pública completa, por exemplo https://seu-servico.up.railway.app
APP_URL=
# Padrão privado. Para permitir criação pública de contas, altere explicitamente para true.
ALLOW_SIGNUP=false
